{
  "manifest_version": 3,
  "name": "MCQ Solver",
  "version": "2.0.0",
  "description": "Reads MCQs on screen and provides the correct answer using AI — no popup, fully inline",
  "permissions": ["activeTab", "storage", "contextMenus"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "host_permissions": ["https://api.groq.com/*"]
}
